# Tomosynthesis acquisition: 5 source positions along Y (source plane z = -15 cm).
# At each position the tube tilts so its axis points at the imaginary focal point
# (0, 0, 102.5 mm). Tube angle from the z-axis = atan(y / 252.5 mm):
#   -20 cm -> -38.4 deg   -10 cm -> -21.6 deg   0 cm -> 0 deg
#   +10 cm -> +21.6 deg   +20 cm -> +38.4 deg
#
# Run from build/: ./sim tomo.mac
# Output files land in the project root (one level above build/).

/sim/notify true
/control/execute init.mac
/run/printProgress 100000

# --- Shot 1: y = -20 cm ---
/gun/positionY -20 cm
/sim/outputFile ../results/raw/xray_image_-20cm.dat
/run/beamOn 1000000

# --- Shot 2: y = -10 cm ---
/gun/positionY -10 cm
/sim/outputFile ../results/raw/xray_image_-10cm.dat
/run/beamOn 1000000

# --- Shot 3: frontal (0 cm) ---
/gun/positionY 0 cm
/sim/outputFile ../results/raw/xray_image_0cm.dat
/run/beamOn 1000000

# --- Shot 4: y = +10 cm ---
/gun/positionY 10 cm
/sim/outputFile ../results/raw/xray_image_+10cm.dat
/run/beamOn 1000000

# --- Shot 5: y = +20 cm ---
/gun/positionY 20 cm
/sim/outputFile ../results/raw/xray_image_+20cm.dat
/run/beamOn 1000000
